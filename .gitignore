# ==========================================
# Root .gitignore for EDU360 Monorepo
# ==========================================

# ------------------------------------------
# Environment & Secrets (Never commit credentials)
# ------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env*.example

# ------------------------------------------
# Python / Backend
# ------------------------------------------
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Local SQLite & Databases
backend/*.db
backend/*.sqlite3
backend/edu360.db
*.db
*.sqlite3

# ------------------------------------------
# Node / Frontend
# ------------------------------------------
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
frontend/build/
build/
frontend/.vercel/
.vercel/

# TypeScript & Next.js cache
*.tsbuildinfo
frontend/next-env.d.ts

# Yarn & Package Managers
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------
# Logs & Debugging
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
*.sublime-project
# ------------------------------------------
# Media & Large Binaries (>50MB)
# ------------------------------------------
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.zip
*.tar.gz
k-5.mp4
